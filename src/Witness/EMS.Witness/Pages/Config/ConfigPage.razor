<label>
	<input class="oi" type="checkbox" checked="@RpcContext.UseLocalHost" @oninput="ChangeRpcConnection" />
	Use Local server
</label>


@code {
	[Inject] private IRpcSocket RpcSocket { get; set; } = default!;
	[Inject]
	private IRpcContext RpcContext { get; set; } = default!;
	[Inject]
	private IRpcInitalizer _rpcInitializer { get; set; } = default!;

	[Inject] private WitnessState _witnessState { get; set; } = default!;
	[Inject]
	private IUpcomingEventRepository _repository { get; set; } = default!;

	[Inject] private IPersistenceService _persistence { get; set; } = default!;

	private IEnumerable<UpcomingEvent> _upcomingEvents = [];

	private async Task ChangeRpcConnection(ChangeEventArgs e)
	{
		RpcContext.UseLocalHost = (bool)e.Value!;
		await _rpcInitializer.Disconnect();
		await _rpcInitializer.StartConnections();
	}

	protected override async Task OnInitializedAsync()
	{
		_upcomingEvents = await _repository.ReadAll();
	}

	private async Task Connect(UpcomingEvent upcomingEvent)
	{
		_witnessState.EventId = upcomingEvent.Id;
		_witnessState.EventName = upcomingEvent.Name;
		await NavMenu.StartRpcConnections(_rpcInitializer, _witnessState);
		await _persistence.RestoreIfAny(upcomingEvent.Id);
	}

	private IEnumerable<ParticipantEntry> LoadParticipants(UpcomingEvent upcomingEvent)
	{
		foreach (var competition in upcomingEvent.Competitions)
		{
			foreach (var participation in competition.Participations)
			{
				var participant = ParticipationFactory.CreateEms(participation, competition);
				yield return new ParticipantEntry(participant);
			}
		}
	}
}
