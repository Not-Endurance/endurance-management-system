@using Core.Application.Rpc
@using Core.Domain.AggregateRoots.Manager.Aggregates.Participants
@using EMS.Witness.ConverterFactories
@using EMS.Witness.Models
@using EMS.Witness.Services

@page "/config"
<a class="navbar-brand" href="">Endurance events</a>

<div class="row">
	<table class="table">
		<thead>
		<tr>
			<th>Place</th>
			<th>Name</th>
			<th>Action</th>
		</tr>
		</thead>
		<tbody>
		@if (!_upcomingEvents.Any())
		{
			<div class="col-3">
				<div class="spinner-border text-warning" role="status">
					<span class="visually-hidden">Loading...</span>
				</div>
			</div>
		}
		else
		{
			foreach (var upcomingEvent in _upcomingEvents)
			{
				var isDisabled = _witnessState.EventId == upcomingEvent.Id;
				var text = isDisabled ? "Connected" : "Connect";
				<tr>
					<td>
						<span>@upcomingEvent.Place</span>
					</td>
					<td>
						<span>@upcomingEvent.Name</span>
					</td>
					<td>
						<button class="btn btn-success btn-table" @onclick="_ => Connect(upcomingEvent)" disabled="@isDisabled">@text</button>
					</td>
				</tr>
			}	
		}
		</tbody>
	</table>
</div>

<br />
@if (!RpcSocket.IsConnected && _witnessState.EventId != null && !NavMenu.IsConnecting)
{
	<p>This isn't supposed to be visible</p>
	<button class="btn btn-warning" @onclick="() => NavMenu.StartRpcConnections(_rpcInitializer, _witnessState)">Reconnect</button>
}

<br />
