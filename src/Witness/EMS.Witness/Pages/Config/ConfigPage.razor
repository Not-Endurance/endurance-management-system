<label>
	<input class="oi" type="checkbox" checked="@RpcContext.UseLocalHost" @oninput="ChangeRpcConnection" />
	Use Local server
</label>


@code {
	[Inject] private IRpcSocket RpcSocket { get; set; } = default!;
	[Inject]
	private IRpcContext RpcContext { get; set; } = default!;
	[Inject]
	private IRpcInitalizer _rpcInitializer { get; set; } = default!;

	[Inject] private WitnessState _witnessState { get; set; } = default!;
	[Inject]
	private IUpcomingEventRepository _repository { get; set; } = default!;

	[Inject] private IPersistenceService _persistence { get; set; } = default!;
	[Inject]
	private IPopupService _popupService { get; set; } = default!;
	[Inject]
	private IParticipantsService _participantService { get; set; } = default!;
	[Inject]
	private NavigationManager NavigationManager { get; set; } = default!;

	private IEnumerable<UpcomingEventModel> _upcomingEvents = [];

	private async Task ChangeRpcConnection(ChangeEventArgs e)
	{
		RpcContext.UseLocalHost = (bool)e.Value!;
		await _rpcInitializer.Disconnect();
		await _rpcInitializer.StartConnections();
	}

	protected override async Task OnInitializedAsync()
	{
		_upcomingEvents = await _repository.ReadAll();
		RpcSocket.ServerConnectionChanged += (_, __) => InvokeAsync(StateHasChanged);
	}

	private async Task OpenResetDialog()
	{
		if (!await _popupService.Confirm("Are you sure you want to reset? History cannot be recovered"))
		{
			return;
		}
		await _persistence.Reset();
		await _participantService.Reset();
		NavigationManager.NavigateTo("/");
	}

	private async Task Connect(UpcomingEventModel upcomingEventModel)
	{
		_witnessState.EventId = upcomingEventModel.Id;
		_witnessState.EventName = upcomingEventModel.Name;
		await NavMenu.StartRpcConnections(_rpcInitializer, _witnessState);
		await _persistence.RestoreIfAny(upcomingEventModel.Id, upcomingEventModel.Name);
		NavigationManager.NavigateTo("/");
	}

	private IEnumerable<ParticipantEntry> LoadParticipants(UpcomingEventModel upcomingEventModel)
	{
		foreach (var competition in upcomingEventModel.Competitions)
		{
			foreach (var participation in competition.Participations)
			{
				var participant = ParticipationFactory.CreateEms(participation, competition);
				yield return new ParticipantEntry(participant);
			}
		}
	}
}
